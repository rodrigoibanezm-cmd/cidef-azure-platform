FROM node:22-bookworm-slim
ENV NODE_ENV=production
WORKDIR /app
COPY motor-test-azure/package.json ./package.json
RUN npm install --omit=dev --no-audit --no-fund
COPY lib ./lib
COPY motor-test-azure/server.js ./motor-test-azure/server.js
USER node
EXPOSE 3000
CMD ["node", "motor-test-azure/server.js"]
