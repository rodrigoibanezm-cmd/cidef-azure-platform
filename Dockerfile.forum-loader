FROM node:22-bookworm-slim
WORKDIR /app
COPY package.json ./
RUN npm install --omit=dev --ignore-scripts
COPY lib ./lib
COPY scripts/recover-forum-snapshots-azure.js scripts/refresh-forum-ventas-snapshot-azure.js ./scripts/
COPY docs ./docs
# Publication still requires a valid docs/forum-snapshot-parity.json.
CMD ["node", "scripts/recover-forum-snapshots-azure.js"]
