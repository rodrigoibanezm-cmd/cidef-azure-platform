FROM node:22-bookworm-slim
ENV NODE_ENV=production
WORKDIR /app
COPY mcp/package.json ./package.json
RUN npm install --omit=dev --no-audit --no-fund
COPY mcp/server.js ./server.js
COPY lib ./lib
COPY scripts/pricing/price-episode-canonicalizer-v01.js ./scripts/pricing/price-episode-canonicalizer-v01.js
COPY scripts/pricing-p1 ./scripts/pricing-p1
COPY scripts/verify-sales-p1.js ./scripts/verify-sales-p1.js
COPY scripts/verify-rvm-p1.js ./scripts/verify-rvm-p1.js
COPY scripts/verify-crm-p1.js ./scripts/verify-crm-p1.js
COPY scripts/verify-forum-p1.js ./scripts/verify-forum-p1.js
COPY scripts/install-forum-universe-view.js ./scripts/install-forum-universe-view.js
COPY scripts/forum-raw-inventory.js ./scripts/forum-raw-inventory.js
COPY scripts/recover-forum-snapshots-azure.js ./scripts/recover-forum-snapshots-azure.js
USER node
EXPOSE 3000
CMD ["node", "server.js"]
