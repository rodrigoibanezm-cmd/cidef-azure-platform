FROM node:22-bookworm-slim
WORKDIR /app
COPY package.json ./
RUN npm install --omit=dev --ignore-scripts
COPY lib ./lib
COPY src/loaders/rvm ./src/loaders/rvm
COPY scripts/refresh-rvm-azure.js scripts/download-anac-rvm-azure.js ./scripts/
# ANAC omits its RapidSSL intermediate CA; retain normal TLS verification.
RUN node -e 'const https=require("node:https"),fs=require("node:fs"),crypto=require("node:crypto"); const url="https://cacerts.digicert.com/RapidSSLTLSRSACAG1.crt"; https.get(url,res=>{if(res.statusCode!==200)throw Error("CA download HTTP "+res.statusCode); const chunks=[];res.on("data",x=>chunks.push(x));res.on("end",()=>{const der=Buffer.concat(chunks);const cert=new crypto.X509Certificate(der);if(cert.fingerprint256.replaceAll(":","").toLowerCase()!=="4422e963ee53cd58cc9f85cd40bf5ffec0095fdf1a154535661c1c06bcadc69b")throw Error("Unexpected DigiCert CA");fs.writeFileSync("/app/anac-intermediate.pem",cert.toString()+"\\n");});}).on("error",e=>{console.error(e);process.exitCode=1;});'
ENV NODE_EXTRA_CA_CERTS=/app/anac-intermediate.pem
CMD ["node", "scripts/refresh-rvm-azure.js"]
