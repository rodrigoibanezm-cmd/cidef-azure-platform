FROM node:22-bookworm-slim
WORKDIR /app
COPY package.json ./
RUN npm install --omit=dev --ignore-scripts
COPY lib ./lib
COPY src ./src
COPY scripts/refresh-sales-sources-azure.js ./scripts/refresh-sales-sources-azure.js
ENV NODE_OPTIONS="--max-old-space-size=2048"
CMD ["node", "scripts/refresh-sales-sources-azure.js"]
